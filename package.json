{
  "name": "shift-idle-factory",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 4173",
    "build": "vite build && node scripts/make-classic.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "test": "node --test tests/*.test.js",
    "ios": "npm run build && npx cap sync ios",
    "ios:open": "npm run build && npx cap sync ios && npx cap open ios"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "vite": "7.1.5"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/preferences": "^8.0.1"
  }
}
