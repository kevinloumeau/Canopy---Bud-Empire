<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The shop tracks nobody: no account, no advertising identifier, nothing shared with data brokers. -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<!-- Anonymous gameplay counts go to TelemetryDeck (src/telemetry-deck.js) once its App ID is set: product
	     interaction only, keyed to a random install id the SDK hashes, never linked to the player and never used
	     for tracking. Declared now so the manifest is already right the day analytics switch on, and it matches
	     the App Store privacy label (Usage Data > Product Interaction, Analytics, not linked, not tracking) and
	     the public privacy page (public/privacy/index.html). The save, the age answer and purchases stay on device. -->
	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeProductInteraction</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
			</array>
		</dict>
	</array>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<!-- Capacitor's Preferences plugin keeps the save mirror in UserDefaults, and unlike Capacitor's own
			     frameworks it ships no manifest of its own, so the reason is declared here for it. CA92.1 is
			     "access info from the app itself" — the only thing read back is this app's own saved shop. -->
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
