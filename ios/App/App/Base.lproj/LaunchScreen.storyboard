                        <autoresizingMask key="autoresizingMask"/>
                        <!-- The opening frame of the in-app loading cover (CanopyViewController.installLoadingCover):
                             same seed, empty loading bar, spacing and centring, so the hand-off is seamless and the app
                             then grows it into the sprout. The shop's own forest green (#20372b), not systemBackgroundColor:
                             that is white in light mode, which flashed before the web view painted. -->
                        <subviews>
                            <stackView opaque="NO" contentMode="scaleToFill" axis="vertical" alignment="center" spacing="12" translatesAutoresizingMaskIntoConstraints="NO" id="stk-Ld-001">
                                <rect key="frame" x="0.0" y="0.0" width="10" height="10"/>
                                <subviews>
                                    <imageView clipsSubviews="YES" userInteractionEnabled="NO" contentMode="scaleAspectFit" horizontalHuggingPriority="251" verticalHuggingPriority="251" image="Sprout" translatesAutoresizingMaskIntoConstraints="NO" id="img-Ld-002">
                                        <constraints>
                                            <constraint firstAttribute="width" constant="96" id="c-Ld-003"/>
                                            <constraint firstAttribute="height" constant="96" id="c-Ld-004"/>
                                        </constraints>
                                    </imageView>
                                    <imageView clipsSubviews="YES" userInteractionEnabled="NO" contentMode="scaleAspectFit" horizontalHuggingPriority="251" verticalHuggingPriority="251" image="LoadTrack" translatesAutoresizingMaskIntoConstraints="NO" id="bar-Ld-005">
                                        <constraints>
                                            <constraint firstAttribute="width" constant="168" id="c-Ld-008"/>
                                            <constraint firstAttribute="height" constant="14" id="c-Ld-009"/>
