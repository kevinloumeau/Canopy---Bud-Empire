                        <autoresizingMask key="autoresizingMask"/>
                        <!-- The opening frame of the in-app loading cover (CanopyViewController.installLoadingCover): Kevin's
                             background full width from 60 pt above the top edge, the scrim rising 220 pt above the safe
                             bottom, the empty track 61 pt above it with the sprout at its start, all by the same
                             constraints, so the hand-off is seamless (the app then drops the badge in). Keep the two in
                             step if either changes. -->
                        <subviews>
                            <imageView clipsSubviews="YES" userInteractionEnabled="NO" contentMode="scaleAspectFill" image="LoadingArt" translatesAutoresizingMaskIntoConstraints="NO" id="art-Ld-001">
                                <rect key="frame" x="0.0" y="-60" width="375" height="1049"/>
                            </imageView>
                            <imageView userInteractionEnabled="NO" contentMode="scaleToFill" image="LoadScrim" translatesAutoresizingMaskIntoConstraints="NO" id="band-Ld-002">
