                                            <constraint firstAttribute="height" constant="39.5" id="c-Ld-105"/>
                                        </constraints>
                                    </imageView>
                                </subviews>
                                <constraints>
                                    <constraint firstItem="track-Ld-004" firstAttribute="centerX" secondItem="band-Ld-002" secondAttribute="centerX" id="c-Ld-110"/>
                                    <constraint firstItem="track-Ld-004" firstAttribute="width" secondItem="band-Ld-002" secondAttribute="width" priority="750" constant="-56" id="c-Ld-111"/>
                                    <constraint firstItem="sprout-Ld-005" firstAttribute="bottom" secondItem="track-Ld-004" secondAttribute="bottom" constant="-4" id="c-Ld-112"/>
                                    <constraint firstItem="sprout-Ld-005" firstAttribute="centerX" secondItem="track-Ld-004" secondAttribute="leading" constant="15.35" id="c-Ld-113"/>
